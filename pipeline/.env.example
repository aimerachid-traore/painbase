# ================================================================
#  PainBase — Variables d'environnement
#  Copie ce fichier en .env et remplis les valeurs
#  NE JAMAIS committer .env sur GitHub
# ================================================================

# ── Supabase (obligatoire) ──────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
# Où : Supabase → Settings → API → Project URL

SUPABASE_SERVICE_KEY=eyJhbGci...
# Où : Supabase → Settings → API → service_role (clé secrète)
# ⚠️  Différente de la anon key — bypass les sécurités RLS

# ── Groq IA (recommandé, gratuit) ──────────────────────────────
GROQ_API_KEY=gsk_...
# Où : https://console.groq.com → API Keys → Create API Key
# Plan gratuit : 14 400 req/jour sur llama-3.1-8b-instant

# ── Social Searcher (Twitter + Facebook + Instagram) ───────────
SOCIAL_SEARCHER_KEY=your_key_here
# Où : https://www.social-searcher.com/api/ → Sign up → Free Plan
# Plan gratuit : 100 recherches/jour (Twitter, Facebook, Instagram, YouTube)
