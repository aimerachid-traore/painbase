# ================================================================
#  PainBase — Variables d'environnement
#  1. Copie ce fichier : cp .env.example .env
#  2. Remplis les valeurs dans .env
#  ⚠️  Ne JAMAIS committer .env sur GitHub
# ================================================================

# ── SUPABASE (obligatoire) ──────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
# → Supabase Dashboard → Settings → API → Project URL

SUPABASE_SERVICE_KEY=eyJ...service_role...
# → Supabase Dashboard → Settings → API → service_role key
# ⚠️  IMPORTANT : c'est la clé "service_role" (pas la clé "anon")
#    La clé anon commence par "eyJ...role":"anon"
#    La clé service_role commence par "eyJ...role":"service_role"
#    Vérifie sur jwt.io si tu n'es pas sûr

# ── GROQ IA (recommandé, gratuit) ──────────────────────────────
GROQ_API_KEY=gsk_...
# → https://console.groq.com → API Keys → Create API Key
# Plan gratuit : 14 400 req/jour (llama-3.1-8b-instant)
# Sans cette clé : la classification IA est désactivée, le reste fonctionne

# ── APIFY pour Facebook (optionnel, $5 crédit/mois offert) ─────
APIFY_TOKEN=apify_api_...
# → https://apify.com → Créer compte gratuit → Console → Settings → API token
# Permet de scraper les posts Facebook publics
# Sans cette clé : Facebook est ignoré, les autres sources fonctionnent
